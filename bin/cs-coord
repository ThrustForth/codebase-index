#!/usr/bin/env fish
# cs-coord: Brain AI + OpenRouter coordinated search (for Code Puppy)

set task $argv[1]
set ext $argv[2]
set top_k $argv[3]

if test -z "$task"
    echo "Usage: cs-coord <query> <extension> <top_k>"
    echo "Example: cs-coord ollama .py 3"
    exit 1
end

if test -z "$ext"
    set ext ".py"
end

if test -z "$top_k"
    set top_k "3"
end

cd ~/projects/codebase-index

echo "🧠💻 Brain+OpenRouter Coordinated Search"
echo "📍 Query: $task"
echo "📍 Extension: $ext"
echo "📍 Top-K: $top_k"
echo ""

# Phase 1: OpenRouter fast generation
echo "⚡️ Phase 1: OpenRouter fast generation (5s)"
set initial_code (python3 ./index_repo.py --search "$task" --ext "$ext" --top "$top_k")
set initial_len (string length "$initial_code")
echo "   ✅ Generated $initial_len chars"
echo ""

# Show initial code
echo "📄 INITIAL CODE (OpenRouter):"
echo "---"
echo "$initial_code"
echo "---"
echo ""

# Phase 2: Brain deep analysis
echo "🧠 Phase 2: Brain deep analysis (30-60s)"
set brain_prompt_file "/tmp/brain_prompt_coord_$$.txt"
printf "Analyze this code for: %s\n\nCODE:\n%s\n\nProvide:\n1. Technical critique (bugs, edge cases, performance issues)\n2. Architecture improvements\n3. Security concerns\n4. Better alternatives or patterns" "$task" "$initial_code" > "$brain_prompt_file"

echo "   📝 Sending to Brain AI (ID+EGO+SUPER-EGO agents)..."
set brain_critique (~/projects/brain-ai/brain_ai/run_brain_task.fish < "$brain_prompt_file")
set critique_len (string length "$brain_critique")
echo "   ✅ Brain critique: $critique_len chars"
echo ""

if test "$critique_len" -gt 10
    echo "📋 BRAIN CRITIQUE:"
    echo "---"
    echo "$brain_critique"
    echo "---"
    echo ""
end

# Phase 3: Refinement
echo "🔄 Phase 3: Refinement (Brain critiques → OpenRouter improves)"
set refinement_file "/tmp/brain_refine_coord_$$.txt"
printf "Improve this code based on Brain AI's multi-agent critique:\n\nTASK: %s\n\nORIGINAL CODE:\n%s\n\nBRAIN'S CRITIQUE (from ID+EGO+SUPER-EGO agents):\n%s\n\nGenerate improved code that addresses ALL critique points. Include:\n- Fix all bugs and edge cases\n- Add error handling\n- Improve performance\n- Address security concerns\n- Use better architecture patterns" "$task" "$initial_code" "$brain_critique" > "$refinement_file"

set refined_code (python3 ./index_repo.py --search "$refinement_file" --ext "$ext" --top 1)
set refined_len (string length "$refined_code")
echo "   ✅ Refinement complete: $refined_len chars"
echo ""

# Phase 4: Final output
echo "✅ COORDINATED SEARCH COMPLETE"
echo ""
echo "============================================================"
echo "🏆 FINAL CODE (Brain-coordinated OpenRouter):"
echo "============================================================"
echo "$refined_code"
echo ""
echo "Summary:"
echo "  - Initial: $initial_len chars (OpenRouter fast)"
echo "  - Refined: $refined_len chars (Brain-coordinated)"
echo "  - Brain critique: $critique_len chars"
echo "============================================================"

# Cleanup
rm -f "$brain_prompt_file" "$refinement_file"
